---
import { Picture } from 'astro:assets';
import { t as tr, type Lang } from '../i18n/ui';
import { dataFor } from '../i18n/data';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = tr(lang);
const { profile, partners } = dataFor(lang);
const cvHref = import.meta.env.BASE_URL.replace(/\/$/, '') + '/' + profile.cv;
import headshot from '../assets/kenji-headshot.jpg';
---

<!-- One full-width block: who, the headline across the page, then the intro
     beside the actions, and the partners as one reference line. -->
<section class="hero" id="top" aria-labelledby="hero-title" data-enter>
  <div class="wrap">
    <div class="who">
      <Picture
        src={headshot}
        formats={['avif', 'webp']}
        widths={[56, 112, 168]}
        sizes="56px"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="avatar"
      />
      <p class="role"><strong>{profile.name}</strong> · {profile.role}, {profile.location}</p>
    </div>

    <h1 id="hero-title">{profile.headline}</h1>

    <div class="lower">
      <p class="intro">{profile.intro}</p>
      <div class="cta">
        <div class="actions">
          <a href="#contact" class="btn btn-solid">{t.hero.discuss}</a>
          <a href="#work" class="btn btn-line">{t.hero.see}</a>
        </div>
        <p class="avail"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
        {profile.cv && <a class="cv draw" href={cvHref} download>{t.hero.cv}</a>}
      </div>
    </div>

    <div class="trust">
      <p>{t.hero.trust}</p>
      <ul>{partners.map((p) => <li>{p}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 4rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .who :global(.avatar) {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 6px;
    object-fit: cover;
    background: #8c9091;
  }
  .role {
    color: var(--slate);
    font-weight: 500;
    line-height: 1.4;
  }
  .role strong {
    color: var(--ink);
    font-weight: 650;
  }

  /* The headline runs across the page in two lines on desktop. */
  h1 {
    font-size: clamp(2.5rem, 0.75rem + 7.6vw, 8.75rem);
    font-stretch: 122%;
    font-weight: 680;
    letter-spacing: -0.025em;
    line-height: 1.02;
    max-width: none;
  }

  /* Intro on the left, the two actions on the right, bottoms aligned. */
  .lower {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .intro {
    font-family: var(--font-text);
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.375rem);
    line-height: 1.5;
    color: var(--ink);
    max-width: 52ch;
  }
  .cta {
    justify-self: end;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .avail {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--slate);
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .dot {
    flex: none;
    margin-top: 0.45em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 4px var(--lagoon);
  }

  .cv {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.25rem;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .trust {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 2.5rem;
  }
  .trust p {
    color: var(--slate);
    font-size: var(--step--1);
  }
  .trust ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust li {
    font-weight: 500;
    color: var(--ink);
  }
  /* Narrower screens: the names wrap, so no rules (a rule would start a line). */
  @media (max-width: 1099px) {
    .trust ul {
      gap: 0.5rem 1.75rem;
    }
  }
  /* Phones: one name per line. */
  @media (max-width: 600px) {
    .trust {
      gap: 0.6rem;
    }
    .trust ul {
      flex-direction: column;
      gap: 0.45rem;
    }
  }

  /* Desktop: the names spread across the full width, each rule midway
     between two names, the first and last flush with the page edges. */
  @media (min-width: 1100px) {
    .trust ul {
      flex: 1;
      flex-wrap: nowrap;
      gap: 0;
    }
    .trust li {
      flex: 1 1 auto;
      padding-inline: 1.25rem;
      text-align: center;
    }
    /* names separated by thin rules, read as one reference line */
    .trust li + li {
      padding-left: 1.25rem;
      border-left: 1px solid var(--rule);
    }
    .trust li:first-child {
      flex-grow: 0.5;
      padding-left: 0;
      text-align: left;
    }
    .trust li:last-child {
      flex-grow: 0.5;
      padding-right: 0;
      text-align: right;
    }
  }

  /* Entrance: each row rises once on load. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  [data-enter] .wrap > * {
    animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  [data-enter] .wrap > :nth-child(2) {
    animation-delay: 70ms;
  }
  [data-enter] .wrap > :nth-child(3) {
    animation-delay: 150ms;
  }
  [data-enter] .wrap > :nth-child(4) {
    animation-delay: 240ms;
  }

  @media (max-width: 860px) {
    .lower {
      grid-template-columns: 1fr;
    }
    .cta {
      justify-self: start;
    }
  }
  @media (max-width: 520px) {
    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
