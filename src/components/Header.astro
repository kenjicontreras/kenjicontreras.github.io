---
import { profile } from '../data/profile';
---

<header class="header" data-header>
  <div class="wrap inner">
    <a href="#top" class="name">{profile.name}</a>
    <nav aria-label="Sections">
      <a class="draw" href="#skills">Skills</a>
      <a class="draw" href="#work">Projects</a>
      <a class="draw" href="#experience">Experience</a>
      <a class="draw" href="#about">About</a>
      <a class="draw contact-link" href="#contact">Contact</a>
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-btn
      >
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </nav>
  </div>
  <!-- Phones: the sections the header has no room for, in a drop-down panel. -->
  <div class="mpanel" id="mobile-menu" hidden data-menu>
    <nav class="wrap" aria-label="Sections">
      <a href="#skills">Skills</a>
      <a href="#work">Projects</a>
      <a href="#experience">Experience</a>
      <a href="#about">About</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const panel = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    btn.addEventListener('click', () => setOpen(panel.hidden));
    // A link closes the menu; the page then scrolls to the section as usual.
    panel.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !(e.target as Element).closest('[data-menu], [data-menu-btn]')) setOpen(false);
    });
    // Back to a wide screen: the full nav returns, so the panel closes.
    window.matchMedia('(min-width: 641px)').addEventListener('change', (m) => m.matches && setOpen(false));
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms;
  }
  .header:global(.is-scrolled) {
    border-bottom-color: var(--rule);
  }
  .inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .name {
    font-weight: 700;
    font-stretch: 118%;
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  nav a:not(.btn):hover {
    color: var(--teal);
  }
  .name {
    white-space: nowrap;
  }
  /* Contact stays visible on phones, set off by a rule from the rest. */
  nav a.contact-link {
    margin-left: 0.5rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
    font-weight: 650;
    color: var(--teal-deep);
  }
  .menu-btn,
  .mpanel {
    display: none;
  }
  @media (max-width: 640px) {
    .inner > nav a:not(.contact-link) {
      display: none;
    }
    nav a.contact-link {
      border-left: 0;
      padding-left: 0.75rem;
      margin-left: 0;
    }
    .menu-btn {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--ink);
      cursor: pointer;
    }
    .bars {
      display: grid;
      gap: 5px;
      width: 22px;
    }
    .bars span {
      display: block;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition: transform 200ms, opacity 200ms;
    }
    /* open: the three bars become a cross */
    .menu-btn[aria-expanded='true'] .bars span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .menu-btn[aria-expanded='true'] .bars span:nth-child(2) {
      opacity: 0;
    }
    .menu-btn[aria-expanded='true'] .bars span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
    .mpanel {
      display: block;
      position: absolute;
      inset: 100% 0 auto;
      background: var(--paper);
      border-top: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
      box-shadow: 0 12px 24px -16px rgba(13, 42, 58, 0.35);
    }
    .mpanel[hidden] {
      display: none;
    }
    .mpanel nav {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: 0.5rem;
    }
    .mpanel nav a {
      min-height: 48px;
      padding-inline: 0;
      font-size: 1.0625rem;
    }
    .mpanel nav a + a {
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 640px) and (prefers-reduced-motion: reduce) {
    .bars span {
      transition: none;
    }
  }
</style>
