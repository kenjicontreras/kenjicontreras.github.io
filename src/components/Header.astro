---
import { profile } from '../data/profile';
import { t as tr, langs, pathFor, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = tr(lang);
const landing = pathFor(lang);
const onLanding = Astro.url.pathname.replace(/\/$/, '') === landing.replace(/\/$/, '');
const sectionHref = (id: string) => `${onLanding ? '' : landing}#${id}`;
---

<header class="header" data-header>
  <div class="wrap inner">
    <a href={sectionHref('top')} class="name">{profile.name}</a>
    <nav aria-label={t.navLabel}>
      <a class="draw" href={sectionHref('skills')}>{t.nav.skills}</a>
      <a class="draw" href={sectionHref('work')}>{t.nav.work}</a>
      <a class="draw" href={sectionHref('experience')}>{t.nav.experience}</a>
      <a class="draw" href={sectionHref('about')}>{t.nav.about}</a>
      <a class="draw contact-link" href={sectionHref('contact')}>{t.nav.contact}</a>
      <span class="lang" role="group" aria-label={t.langLabel}>
        {
          langs.map((l) =>
            l === lang ? (
              <span class="cur" aria-current="true" lang={l} title={t.langName[l]}>{l.toUpperCase()}</span>
            ) : (
              <a class="alt" href={pathFor(l)} hreflang={l} lang={l} title={t.langName[l]} aria-label={t.langName[l]} data-lang-link>{l.toUpperCase()}</a>
            ),
          )
        }
      </span>
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.openMenu}
        data-open-label={t.openMenu}
        data-close-label={t.closeMenu}
        data-menu-btn
      >
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </nav>
  </div>
  <!-- Phones: the sections the header has no room for, in a drop-down panel. -->
  <div class="mpanel" id="mobile-menu" hidden data-menu data-lenis-prevent>
    <nav class="wrap" aria-label={t.navLabel}>
      <a href={sectionHref('skills')}>{t.nav.skills}</a>
      <a href={sectionHref('work')}>{t.nav.work}</a>
      <a href={sectionHref('experience')}>{t.nav.experience}</a>
      <a href={sectionHref('about')}>{t.nav.about}</a>
      <a href={sectionHref('contact')} class="m-contact">{t.nav.contact}</a>
    </nav>
    <div class="wrap m-lang" role="group" aria-label={t.langLabel}>
      {
        langs.map((l) =>
          l === lang ? (
            <span class="cur" aria-current="true" lang={l}>{t.langName[l]}</span>
          ) : (
            <a class="alt" href={pathFor(l)} hreflang={l} lang={l} data-lang-link>{t.langName[l]}</a>
          ),
        )
      }
    </div>
  </div>
</header>

<script>
  // Switching language keeps the reader's place: the section or story in the hash carries over.
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach((a) =>
    a.addEventListener('click', () => {
      if (location.hash) a.href = a.href.split('#')[0] + location.hash;
    }),
  );

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const panel = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', (open ? btn.dataset.closeLabel : btn.dataset.openLabel) || '');
    };
    btn.addEventListener('click', () => setOpen(panel.hidden));
    // A link closes the menu; the page then scrolls to the section as usual.
    panel.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('focusin', (event) => {
      if (event.target !== btn && !panel.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !(e.target as Element).closest('[data-menu], [data-menu-btn]')) setOpen(false);
    });
    // Back to a wide screen: the full nav returns, so the panel closes.
    window.matchMedia('(min-width: 901px)').addEventListener('change', (m) => m.matches && setOpen(false));
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms;
  }
  .header:global(.is-scrolled) {
    border-bottom-color: var(--rule);
  }
  .inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .name {
    font-weight: 700;
    font-stretch: 118%;
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  nav a:not(.btn):hover {
    color: var(--teal);
  }
  .name {
    white-space: nowrap;
  }
  /* Contact is set off by a rule from the rest. */
  nav a.contact-link {
    margin-left: 0.5rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
    font-weight: 650;
    color: var(--teal-deep);
  }
  /* Language switch: the current language in ink, the other one a link. */
  .lang {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--rule);
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.04em;
  }
  .lang .cur,
  nav .lang a.alt {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.45rem;
    font-weight: 650;
  }
  .lang .cur {
    color: var(--ink);
  }
  nav .lang a.alt {
    color: var(--slate);
    min-width: 44px;
    justify-content: center;
  }
  nav .lang a.alt:hover {
    color: var(--teal);
  }
  .menu-btn,
  .mpanel {
    display: none;
  }
  @media (max-width: 900px) {
    /* Phones: every section, Contact included, lives in the menu. */
    .inner > nav a,
    .inner > nav .lang {
      display: none;
    }
    .menu-btn {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--ink);
      cursor: pointer;
    }
    .bars {
      display: grid;
      gap: 5px;
      width: 22px;
    }
    .bars span {
      display: block;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition: transform 200ms, opacity 200ms;
    }
    /* open: the three bars become a cross */
    .menu-btn[aria-expanded='true'] .bars span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .menu-btn[aria-expanded='true'] .bars span:nth-child(2) {
      opacity: 0;
    }
    .menu-btn[aria-expanded='true'] .bars span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
    .mpanel {
      display: block;
      position: absolute;
      inset: 100% 0 auto;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--paper);
      border-top: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
      box-shadow: 0 12px 24px -16px rgba(13, 42, 58, 0.35);
    }
    .mpanel[hidden] {
      display: none;
    }
    .mpanel nav {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: 0.5rem 0;
    }
    .mpanel nav a {
      min-height: 48px;
      padding-inline: 0;
      font-size: 1.0625rem;
    }
    .mpanel nav a + a {
      border-top: 1px solid var(--rule);
    }
    .mpanel nav a.m-contact {
      font-weight: 650;
      color: var(--teal-deep);
    }
    .m-lang {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      border-top: 1px solid var(--rule);
      padding-block: 0.25rem 0.5rem;
      font-size: 1.0625rem;
    }
    .m-lang .cur,
    .m-lang a.alt {
      display: inline-flex;
      align-items: center;
      min-height: 48px;
    }
    .m-lang .cur {
      font-weight: 650;
      color: var(--ink);
    }
    .m-lang a.alt {
      font-weight: 500;
      color: var(--slate);
      text-decoration: underline;
      text-underline-offset: 0.25em;
      text-decoration-color: var(--rule);
    }
  }
  @media (max-width: 900px) and (prefers-reduced-motion: reduce) {
    .bars span {
      transition: none;
    }
  }
</style>
