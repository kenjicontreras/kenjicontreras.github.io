---
import { skills } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- The skills as a ruled index: name and what it covers. -->
<section class="block" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="block-head">
      <h2 id="skills-title">What I do</h2>
    </div>

    <ul class="index">
      {
        skills.map((s) => (
          <li class="row">
            <h3>{s.name}</h3>
            <div class="body">
              <p class="line">{s.line}</p>
              {s.tools && (
                <ul class="tools" aria-label="Tools">
                  {s.tools.map((t) => (
                    <li>
                      {t.icon && <img src={base + t.icon} alt="" width="24" height="24" loading="lazy" decoding="async" />}
                      {t.name}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  #skills {
    padding-block: clamp(3.5rem, 7vw, 5rem);
  }
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 0.5rem clamp(1.5rem, 3.5vw, 3rem);
    align-items: baseline;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--rule);
  }
  h3 {
    font-size: var(--step-1);
    font-stretch: 108%;
    line-height: 1.25;
  }
  .line {
    font-family: var(--font-text);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 66ch;
  }
  .tools {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .tools li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tools img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
  }
  @media (max-width: 600px) {
    #skills {
      padding-block: 3.5rem;
    }
  }
</style>
