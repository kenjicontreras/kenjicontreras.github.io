---
import { skills } from '../data/profile';
import { projects } from '../data/work';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tabLabel = (id: string) => projects.find((p) => p.id === id)?.tab ?? id;
---

<!-- The skills as a ruled index: name, what it covers, where to see it. -->
<section class="block" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="block-head">
      <h2 id="skills-title">What I do</h2>
    </div>

    <!-- Column label for the third column (wide screens); each row keeps its own label for phones and screen readers. -->
    <div class="cols" aria-hidden="true">
      <span></span><span></span><span>Projects</span>
    </div>
    <ul class="index">
      {
        skills.map((s) => (
          <li class="row">
            <h3>{s.name}</h3>
            <div class="body">
              <p class="line">{s.line}</p>
              {s.tools && (
                <ul class="tools" aria-label="Tools">
                  {s.tools.map((t) => (
                    <li>
                      {t.icon && <img src={base + t.icon} alt="" width="24" height="24" loading="lazy" decoding="async" />}
                      {t.name}
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {(s.seenIn || s.seenAt) && (
              <p class="seen">
                <span class={s.seenIn ? 'lbl in' : 'lbl'}>{s.seenIn ? 'Projects' : 'Seen at'}</span>
                {s.seenIn?.map((id) => (
                  <a class="draw" href={`#${id}`}>{tabLabel(id)}</a>
                ))}
                {s.seenAt && <a class="draw" href={s.seenAt.href}>{s.seenAt.label}</a>}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  #skills {
    padding-block: clamp(3.5rem, 7vw, 5rem);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 0 clamp(1.5rem, 3.5vw, 3rem);
    padding-bottom: 0.6rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--slate);
  }
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 0.5rem clamp(1.5rem, 3.5vw, 3rem);
    align-items: baseline;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--rule);
  }
  h3 {
    font-size: var(--step-1);
    font-stretch: 108%;
    line-height: 1.25;
  }
  .line {
    font-family: var(--font-text);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 46ch;
  }
  .tools {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .tools li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tools img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .seen {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.9rem;
    font-size: var(--step--1);
    line-height: 1.3;
  }
  .seen span {
    color: var(--slate);
  }
  .seen a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-weight: 600;
  }

  /* On wide screens the column label above says it; keep the text for screen readers. */
  @media (min-width: 901px) {
    .seen .lbl.in {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 900px) {
    .cols {
      display: none;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
    .seen a {
      min-height: 44px;
    }
  }
</style>
