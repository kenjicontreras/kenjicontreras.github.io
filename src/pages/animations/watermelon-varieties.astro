---
// Preview page for the watermelon-varieties scroll story. It is a review
// surface; on the landing page the story is one of the project tabs.
// Add ?step=1 … ?step=7 to jump to a step.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import ScrollStory from '../../../animations/_shared/ScrollStory.astro';
import Stage from '../../../animations/watermelon-varieties/Stage.astro';
import { content } from '../../../animations/watermelon-varieties/content';
---

<Base title="Preview: watermelon varieties story" description="Review page for the watermelon varieties scroll animation.">
  <Header />
  <main id="main" tabindex="-1" class="preview">
    <div class="wrap note">
      <p><strong>Preview.</strong> Scroll to play the story. The same story runs as a tab on the landing page.</p>
    </div>
    <ScrollStory standalone content={content} scene="watermelon">
      <Stage slot="stage" />
    </ScrollStory>
    <div class="wrap after"><p>End of the story. On the landing page the next project is one tab over.</p></div>
  </main>
</Base>

<style>
  .preview {
    padding-top: var(--header-h);
  }
  .note {
    padding-block: 0.75rem 0;
    color: var(--slate);
    font-size: var(--step--1);
  }
  .after {
    padding-block: 3rem 40vh;
    color: var(--slate);
    border-top: 1px solid var(--rule);
  }
</style>
