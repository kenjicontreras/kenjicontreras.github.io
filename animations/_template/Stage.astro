---
// The stage: one SVG, viewBox 800 × 600, a layer per storyboard step.
// Tag layers with data-l="name"; layers that appear later get class="off".
// The first frame must work as a still image (it is the no-JavaScript view).
import './tokens.css';
---

<div class="xx">
  <div class="canvas">
    <svg viewBox="0 0 800 600" role="presentation" focusable="false">
      <rect data-l="bg" width="800" height="600" fill="var(--xx-deep)"></rect>
      <text data-l="hello" class="off" x="400" y="310" text-anchor="middle" font-size="48">Step 1</text>
    </svg>
  </div>
</div>

<style>
  .canvas {
    width: min(100%, calc((100svh - var(--header-h) - 8rem) * 4 / 3));
    margin-inline: auto;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
  }
  svg {
    width: 100%;
    height: 100%;
    font-family: var(--font);
  }
  text {
    fill: #e9f3f4;
  }
  .off {
    opacity: 0;
    visibility: hidden;
  }
</style>
